# Copy to .env and fill in. .env is gitignored — never commit real values.
# The pipeline runs without any of these; missing credentials degrade gracefully
# (Telegram prints to stdout, Reddit is skipped, enrichment is skipped).

# --- Phase 0: delivery -------------------------------------------------------
# PRIMARY CHANNEL. Create a private Discord server for yourself, then
# Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# No bot registration, no approval, no token refresh.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000/xxxxxxxxxxxxxxxx

# Optional second channel. @BotFather -> /newbot -> token. Then message the bot
# once (bots cannot start a conversation) and read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 1 ------------------------------------------------------------------
# No credentials needed. Reddit is read via its public RSS endpoint; its JSON API
# now requires manual approval under the Responsible Builder Policy. GitHub and
# Hacker News work unauthenticated (GITHUB_TOKEN only raises the rate limit, and
# GitHub Actions injects it for free).

# --- Phase 3: enrichment -----------------------------------------------------
# Which backend to use: glm (free, concurrent) or claude (paid, Batch API, -50%)
ENRICH_BACKEND=glm
# glm-4.5-flash is the free tier (listed at $0 in/out). Paid tiers use
# other ids -- confirm in the z.ai console before changing this.
GLM_MODEL=glm-4.5-flash
GLM_API_KEY=
# Only needed if ENRICH_BACKEND=claude
ANTHROPIC_API_KEY=

# --- Phase 4: prod warehouse -------------------------------------------------
# dev = local DuckDB file. prod = BigQuery, which is what makes the disposable
# GitHub Actions runner irrelevant: nothing important lives on its disk.
DBT_TARGET=dev
BIGQUERY_PROJECT=
BIGQUERY_LOCATION=US
# Locally, prefer `gcloud auth application-default login` over a key file.
# In CI the workflow writes the GCP_SA_KEY secret to disk and sets this.
BIGQUERY_METHOD=oauth
GOOGLE_APPLICATION_CREDENTIALS=

# --- Phase 5: email ----------------------------------------------------------
# Gmail requires 2-Step Verification, then an App Password (16 chars, no spaces).
# Outlook/Microsoft 365 will NOT work: Microsoft permanently disabled Basic Auth
# for SMTP AUTH on 2026-03-01 and Outlook.com personal accounts cannot enable it.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
